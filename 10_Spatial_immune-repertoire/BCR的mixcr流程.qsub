    rm -rf "${FR34_TREE_DIR}/newick"
    mkdir -p "${FR34_TREE_DIR}/newick"


    "${MIXCR}" -Xmx${MIXCR_XMX} exportShmTreesNewick \
        -f \
        --chains IGH \
        "${FR34_SHMT}" \
        "${FR34_TREE_DIR}/newick"


    mark_done \
        "${STEP18_MARKER}" \
        "${FR34_SHMT}" \
        "${FR34_TREE_SUMMARY}" \
        "${FR34_TREE_OBS}" \
        "${FR34_TREE_ALL}"

fi


# ============================================================
# Step 19
# summary
# ============================================================

SUMMARY=${OUTDIR}/${SAMPLE}_pipeline_summary.txt
MANIFEST=${OUTDIR}/${SAMPLE}_file_manifest.tsv

STEP19_MARKER=${CHECKPOINT_DIR}/19_summary.done


if step_valid \
    "${STEP19_MARKER}" \
    "${SUMMARY}" \
    "${MANIFEST}"
then
    echo "[SKIP] Step 19 already completed"
else

    echo
    echo "============================================================"
    echo "Step 19: summary"
    echo "============================================================"


    BCR_CLONES=$(tail -n +2 "${MAIN_BCR}" | wc -l)
    IGH_CLONES=$(tail -n +2 "${MAIN_IGH}" | wc -l)

    VDJ_BCR_CLONES=$(tail -n +2 "${VDJ_BCR}" | wc -l)
    VDJ_IGH_CLONES=$(tail -n +2 "${VDJ_IGH}" | wc -l)

    FR34_IGH_CLONES=$(tail -n +2 "${FR34_TABLE}" | wc -l)


    cat > "${SUMMARY}" <<EOF

MiXCR bulk spatial BCR pipeline summary
========================================

Sample:
${SAMPLE}


MAIN BCR
--------

BCR clonotypes:
${BCR_CLONES}

IGH clonotypes:
${IGH_CLONES}


COMPLETE VDJRegion
------------------

BCR complete VDJRegion:
${VDJ_BCR_CLONES}

IGH complete VDJRegion:
${VDJ_IGH_CLONES}


FR3-FR4
-------

IGH FR3-FR4:
${FR34_IGH_CLONES}


ADATA_READY
-----------

Spot × clone:
${SPOT_BCR_LONG}

Spot summary:
${SPOT_SUMMARY}


QC
--

Clone support:
${CLONE_QC}

Clone support summary:
${CLONE_QC_SUMMARY}


SHM / LINEAGE
-------------

VDJRegion SHM:
${VDJ_SHM_TABLE}

VDJRegion trees:
${VDJ_TREE_DIR}

FR3-FR4 SHM:
${FR34_SHM_TABLE}

FR3-FR4 trees:
${FR34_TREE_DIR}

EOF


    cat > "${MANIFEST}" <<EOF
file_type	file_path
alignments	${ALIGNMENTS}
clna	${CLNA}
main_contigs	${MAIN_CLNS}
global_bcr_clonotypes	${GLOBAL_BCR}
main_bcr_clones	${MAIN_BCR}
main_igh_clones	${MAIN_IGH}
light_chain_clones	${MAIN_LIGHT}
read_to_barcode_umi	${READ_BARCODE_TABLE}
read_to_clone	${READ_CLONE_TABLE}
spot_clone_counts	${SPOT_CLONE_COUNTS}
spot_bcr_long	${SPOT_BCR_LONG}
spot_bcr_summary	${SPOT_SUMMARY}
clone_support_qc	${CLONE_QC}
clone_support_summary	${CLONE_QC_SUMMARY}
complete_vdj_clns	${VDJ_CLNS}
complete_bcr_vdj	${VDJ_BCR}
complete_igh_vdj	${VDJ_IGH}
vdj_allele_corrected	${VDJ_ALLELE_CLNS}
vdj_shm	${VDJ_SHM_TABLE}
vdj_tree	${VDJ_SHMT}
vdj_tree_summary	${VDJ_TREE_SUMMARY}
vdj_tree_nodes_observed	${VDJ_TREE_OBS}
vdj_tree_nodes_all	${VDJ_TREE_ALL}
fr34_clns	${FR34_CLNS}
fr34_table	${FR34_TABLE}
fr34_allele_corrected	${FR34_ALLELE_CLNS}
fr34_shm	${FR34_SHM_TABLE}
fr34_tree	${FR34_SHMT}
fr34_tree_summary	${FR34_TREE_SUMMARY}
fr34_tree_nodes_observed	${FR34_TREE_OBS}
fr34_tree_nodes_all	${FR34_TREE_ALL}
EOF


    mark_done \
        "${STEP19_MARKER}" \
        "${SUMMARY}" \
        "${MANIFEST}"

fi


echo
echo "============================================================"
echo "BCR bulk pipeline completed"
echo "Sample: ${SAMPLE}"
echo "Finished: $(date)"
echo
echo "adata_ready:"
echo "${SPOT_SUMMARY}"
echo
echo "Main BCR:"
echo "${MAIN_BCR}"
echo
echo "Complete VDJ:"
echo "${VDJ_BCR}"
echo
echo "VDJ lineage:"
echo "${VDJ_TREE_DIR}"
echo
echo "FR3-FR4 lineage:"
echo "${FR34_TREE_DIR}"
echo "============================================================"