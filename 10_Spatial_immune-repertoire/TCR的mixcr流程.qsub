spot_clone_counts	${SPOT_CLONE_COUNTS}
spot_tcr_long	${SPOT_TCR_LONG}
spot_tcr_summary	${SPOT_SUMMARY}
clone_support_qc	${CLONE_QC}
clone_support_summary	${CLONE_QC_SUMMARY}
cloneid_correspondence_qc	${CLONE_ID_QC}
cloneid_correspondence_summary	${CLONE_ID_QC_SUMMARY}
vdjregion_clns	${VDJ_CLNS}
vdjregion_tcr	${VDJ_TCR}
vdjregion_tra	${VDJ_TRA}
vdjregion_trb	${VDJ_TRB}
EOF

    rm -f "${TMP_DIR}/vdj_complete_counts.txt"

    mark_done "${STEP12_MARKER}" "${SUMMARY}" "${MANIFEST}"
fi

echo
