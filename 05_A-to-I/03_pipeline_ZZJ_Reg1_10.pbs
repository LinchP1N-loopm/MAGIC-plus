#!/bin/bash
#PBS -N AtoI_03_sample_Reg1_10
#PBS -j oe
#PBS -d /path/to/project/20260505_AtoI/qsub
#PBS -l nodes=1:ppn=10
#PBS -l walltime=48:00:00
#PBS -q gold

set -e
set -u

SAMPLE="sample_Reg1_10"
QSUB=/path/to/project/20260505_AtoI/qsub
DATA=/path/to/project/20260505_AtoI/data
RESULTS=/path/to/project/20260505_AtoI/results/${SAMPLE}
mkdir -p "$RESULTS"

GATK=/path/to/project/software/gatk-4.6.2.0/gatk
REF_FA=/path/to/project/gene-database/ref_kun_mm10/mm10.fa
REF_DICT=/path/to/project/gene-database/ref_kun_mm10/mm10.dict
GTF=/path/to/project/gene-database/ref_kun_mm10/mm10.gtf
RADAR=${DATA}/REDIportal_mm10_editing_sites.bed

PYTHON_SCRIPT=${QSUB}/collect_editing_sites_adapted.py
APPEND_CB_SCRIPT=${QSUB}/append_cb_to_qname.py

MIN_MAP_QUAL=25
MIN_BASE_QUAL=25
MIN_DEPTH=10
MIN_EDIT=1

IN_BAM=/path/to/project/20260307_testdata/data/result_STARsolo/sample_reg1/STARsolo_se/sample_reg1_Aligned_AB.sortedByCoord.out.bam

CB_TO_PIXEL=${DATA}/cb_to_pixel_${SAMPLE}.tsv
PIXEL_TO_CLU=${DATA}/pixel_to_clu_ID_${SAMPLE}.tsv
CLU_TO_REGION=${DATA}/clu_ID_to_region_${SAMPLE}.tsv

echo "[$(date)] ===== ${SAMPLE} START ====="

# ── Step 1 & 2: gatk_env ─────────────────────────────────────
eval "$(micromamba shell hook --shell bash)"
micromamba activate gatk_env

if [ ! -f "$REF_DICT" ]; then
    echo "[$(date)] Step 1: CreateSequenceDictionary..."
    $GATK CreateSequenceDictionary -R "$REF_FA" -O "$REF_DICT"
    echo "[$(date)] Step 1: Done."
else
    echo "[$(date)] Step 1: .dict exists, skip."
fi

SPLIT_BAM="${RESULTS}/${SAMPLE}_split.bam"
if [ ! -f "$SPLIT_BAM" ]; then
    echo "[$(date)] Step 2: SplitNCigarReads..."
    $GATK SplitNCigarReads \
        -R "$REF_FA" \
        -I "$IN_BAM" \
        -O "$SPLIT_BAM"
    echo "[$(date)] Step 2: Done."
else
    echo "[$(date)] Step 2: split BAM exists, skip."
fi

# ── Step 2.5 ~ 4: trackplot2 ─────────────────────────────────
micromamba activate trackplot2

if [ ! -f "${REF_FA}.fai" ]; then
    samtools faidx "$REF_FA"
fi
if [ ! -f "${SPLIT_BAM}.bai" ]; then
    samtools index "$SPLIT_BAM"
fi

CB_BAM="${RESULTS}/${SAMPLE}_split_cb.bam"
CB_BAM_MIN_SIZE=$((100 * 1024 * 1024))
cb_bam_size=0
[ -f "$CB_BAM" ] && cb_bam_size=$(stat -c%s "$CB_BAM")

if [ ! -f "$CB_BAM" ] || [ "$cb_bam_size" -lt "$CB_BAM_MIN_SIZE" ]; then
    [ -f "$CB_BAM" ] && echo "[$(date)] Step 2.5: CB BAM too small (${cb_bam_size} bytes), re-running..."
    echo "[$(date)] Step 2.5: Appending CB to read names (pysam)..."
    python "$APPEND_CB_SCRIPT" "$SPLIT_BAM" "$CB_BAM"
    samtools index "$CB_BAM"
    echo "[$(date)] Step 2.5: Done. Size=$(stat -c%s "$CB_BAM") bytes"
else
    echo "[$(date)] Step 2.5: CB BAM exists and valid (${cb_bam_size} bytes), skip."
fi

MPILEUP_OUT="${RESULTS}/${SAMPLE}_mpileup.tsv"
mpileup_size=0
[ -f "$MPILEUP_OUT" ] && mpileup_size=$(stat -c%s "$MPILEUP_OUT")

if [ ! -f "$MPILEUP_OUT" ] || [ "$mpileup_size" -eq 0 ]; then
    [ -f "$MPILEUP_OUT" ] && echo "[$(date)] Step 3: mpileup output is empty, re-running..."
    echo "[$(date)] Step 3: mpileup..."
    samtools mpileup \
        --no-output-ins --no-output-ins \
        --no-output-del --no-output-del \
        --no-output-ends \
        -B -d 0 \
        -Q ${MIN_BASE_QUAL} -q ${MIN_MAP_QUAL} \
        -l "$RADAR" -f "$REF_FA" \
        "$CB_BAM" --output-QNAME \
        -o "$MPILEUP_OUT"
    echo "[$(date)] Step 3: Done. Lines=$(wc -l < "$MPILEUP_OUT")"
else
    echo "[$(date)] Step 3: mpileup exists and valid (${mpileup_size} bytes), skip."
fi

echo "[$(date)] Step 4: collect_editing_sites_adapted.py..."
python "$PYTHON_SCRIPT" \
    -m "$MIN_DEPTH" -c "$MIN_EDIT" \
    "$MPILEUP_OUT" \
    "$CB_TO_PIXEL" "$PIXEL_TO_CLU" "$CLU_TO_REGION" \
    "$GTF" "$RESULTS"

echo "[$(date)] ===== ${SAMPLE} ALL DONE ====="
